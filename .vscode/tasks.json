{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-commit and push on save",
      "type": "process",
      "command": "npm",
      "args": ["run", "watch:push"],
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "auto-commit-push",
          "pattern": { "regexp": "^$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Auto-commit watcher active",
            "endsPattern": "Auto-commit watcher stopped"
          }
        }
      ],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "focus": false
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    }
  ]
}
